{
  "module": "M1_deceptive_commerce",
  "version": "2026.09.01.2",
  "rules": [
    {
      "id": "M1-001",
      "name": "checkout_countdown_pressure",
      "module": "M1",
      "statute_ref": "CCPA Guidelines 2023 — Category: Creating a false sense of urgency",
      "severity": "MEDIUM",
      "selector_strategy": "text_pattern",
      "match": {
        "target": "[class*='countdown'], [class*='timer'], [id*='countdown'], [id*='timer']",
        "text_patterns": [
          "\\b\\d{1,2}:\\d{2}:\\d{2}\\b",
          "offer ends in \\d+",
          "sale ends in \\d+",
          "hurry[,!] .*\\b(only|last|before)\\b",
          "act (now|fast|quickly).*miss"
        ],
        "case_insensitive": true
      },
      "explanation_template": "A checkout-related countdown or pressure message is present. Its authenticity cannot be established from the page alone."
    },
    {
      "id": "M1-002",
      "name": "basket_sneaking",
      "module": "M1",
      "statute_ref": "CCPA Guidelines 2023 — Category: Basket sneaking",
      "severity": "HIGH",
      "selector_strategy": "structural",
      "match": {
        "target": "input[type='checkbox']",
        "structural_check": {
          "type": "pre_checked_checkbox",
          "reference_selector": "[class*='cart'], [class*='checkout'], [id*='cart'], [id*='checkout']",
          "proximity_px": 300
        },
        "text_patterns": [
          "add .* (protection|insurance|warranty|donation)",
          "extended warranty",
          "include .* (plan|coverage)"
        ],
        "case_insensitive": true
      },
      "explanation_template": "An extra service or fee was pre-selected for you. You must actively opt-in to additions, they shouldn't be snuck into your basket."
    },
    {
      "id": "M1-003",
      "name": "confirm_shaming",
      "module": "M1",
      "statute_ref": "CCPA Guidelines 2023 — Category: Confirmshaming",
      "severity": "MEDIUM",
      "selector_strategy": "text_pattern",
      "match": {
        "target": "button, a[role='button'], [role='button']",
        "text_patterns": [
          "no thanks,? i (prefer|like|enjoy|love) (paying|spend|miss|lose|stay)",
          "i('?d)? rather (not save|pay (full|more))",
          "no,? i('?ll| will) pay (full|more|regular)",
          "no,? (keep|leave) me (uninformed|unprotected)"
        ],
        "case_insensitive": true
      },
      "explanation_template": "The 'decline' button uses guilt-inducing language. You should be able to decline without being emotionally manipulated."
    },
    {
      "id": "M1-004",
      "name": "forced_continuity",
      "module": "M1",
      "statute_ref": "CCPA Guidelines 2023 — Category: Forced continuity",
      "severity": "HIGH",
      "selector_strategy": "structural",
      "match": {
        "target": "button, input[type='submit']",
        "text_patterns": [
          "start (free|my|your) trial",
          "activate (free|my|your) trial"
        ],
        "case_insensitive": true,
        "structural_check": {
          "type": "missing_nearby_element",
          "expected_nearby": "[href*='cancel'], [class*='cancel'], [id*='cancel']",
          "proximity_px": 500
        }
      },
      "explanation_template": "This free trial button doesn't show a clear way to cancel nearby. It should be just as easy to cancel as it is to sign up."
    },
    {
      "id": "M1-005",
      "name": "subscription_trap",
      "module": "M1",
      "statute_ref": "CCPA Guidelines 2023 — Category: Subscription trap",
      "severity": "HIGH",
      "selector_strategy": "structural",
      "match": {
        "target": "button, input[type='submit']",
        "text_patterns": [
          "subscribe now",
          "become a (member|subscriber|premium)"
        ],
        "case_insensitive": true,
        "structural_check": {
          "type": "missing_nearby_element",
          "expected_nearby": "[href*='unsubscribe'], [href*='cancel']",
          "proximity_px": 500
        }
      },
      "explanation_template": "Easy to subscribe, but there's no clear unsubscribe option visible."
    },
    {
      "id": "M1-006",
      "name": "interface_interference",
      "module": "M1",
      "statute_ref": "CCPA Guidelines 2023 — Category: Interface interference",
      "severity": "MEDIUM",
      "selector_strategy": "structural",
      "match": {
        "target": "[role='dialog'] button, [class*='modal'] button, [class*='cookie'] button",
        "structural_check": {
          "type": "visibility_suppressed",
          "threshold": 0.5
        },
        "text_patterns": [
          "^(no thanks|reject|decline|skip)$"
        ],
        "case_insensitive": true
      },
      "explanation_template": "The 'decline' option is visually suppressed — made significantly faded or smaller compared to the accept button."
    },
    {
      "id": "M1-007",
      "name": "checkout_price_change_notice",
      "module": "M1",
      "statute_ref": "CCPA Guidelines 2023 — Category: Bait and switch",
      "severity": "HIGH",
      "selector_strategy": "text_pattern",
      "match": {
        "target": "[class*='checkout'] [class*='price'], [class*='checkout'] [class*='total']",
        "text_patterns": [
          "price changed",
          "updated price",
          "price may (have )?changed"
        ],
        "case_insensitive": true
      },
      "explanation_template": "The checkout reports a price change. Review the item and order summary; the scanner cannot determine whether the change was disclosed earlier."
    },
    {
      "id": "M1-008",
      "name": "checkout_fee_disclosure",
      "module": "M1",
      "statute_ref": "CCPA Guidelines 2023 — Category: Drip pricing",
      "severity": "HIGH",
      "selector_strategy": "text_pattern",
      "match": {
        "target": "[class*='checkout'] *, [class*='order-summary'] *",
        "text_patterns": [
          "(convenience|platform|handling|booking) (fee|charge)",
          "hidden (fee|charge|cost)"
        ],
        "case_insensitive": true
      },
      "explanation_template": "A fee is disclosed in the checkout. The scanner cannot determine whether it was shown before checkout."
    }
  ]
}
